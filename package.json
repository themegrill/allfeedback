{
  "name": "allfeedback",
  "version": "1.0.0",
  "description": "All Feedback Plugin",
  "private": true,
  "scripts": {
    "dev": "wp-scripts start --config webpack.config.js --node-env=development --mode=development --hot",
    "build": "wp-scripts build --config webpack.config.js --node-env=production --mode=production",
    "watch": "wp-scripts start --config webpack.config.js --node-env=development --mode=development",
    "lint": "eslint \"resources/scripts/**/*.{ts,tsx}\"",
    "prettier": "prettier --ignore-path .gitignore --check \"**/*.+(ts|tsx)\"",
    "format": "prettier --ignore-path .gitignore --write \"**/*.+(ts|tsx)\"",
    "prettier:fix": "prettier --write \"**/*.+(ts|tsx)\"",
    "make-pot": "wp i18n make-pot . languages/allfeedback.pot --domain=allfeedback --include=src,allfeedback.php,uninstall.php,resources/build --exclude=resources/build/admin.js.map",
    "release": "gulp release",
    "rename": "node bin/rename.js",
    "switchDev": "node -e \"const fs=require('fs'),p='../../../wp-config.php',c=fs.readFileSync(p,'utf8');fs.writeFileSync(p,c.replace(/define\\('ALLFEEDBACK_ENV',\\s*(true|false)\\)/,\\\"define('ALLFEEDBACK_ENV', true)\\\"))\"",
    "switchProd": "node -e \"const fs=require('fs'),p='../../../wp-config.php',c=fs.readFileSync(p,'utf8');fs.writeFileSync(p,c.replace(/define\\('ALLFEEDBACK_ENV',\\s*(true|false)\\)/,\\\"define('ALLFEEDBACK_ENV', false)\\\"))\""
  },
  "dependencies": {
    "@floating-ui/dom": "^1.7.6",
    "@fontsource-variable/inter": "^5.2.8",
    "@radix-ui/react-dialog": "^1.1.15",
