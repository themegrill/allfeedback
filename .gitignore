# Dependencies
node_modules/
vendor/
release/
build/

# Package manager lockfiles (regenerated on install)
pnpm-lock.yaml
package-lock.json
yarn.lock

# Webpack HMR / dev-server artifacts
resources/build/*.hot-update.js
resources/build/*.hot-update.json
resources/build/*.hot-update.runtime.js

# Webpack generated chunk files
resources/build/node_modules_*.js
resources/build/vendors-node_modules_*.js
resources/build/vendors-*.js

# Compiled build output (regenerated by pnpm build)
resources/build/

# Auto-generated route tree (TanStack Router)
resources/scripts/admin/routeTree.gen.ts

# Environment files
.env
.env.local
.env.*.local

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/
*.suo
*.user

# PHP compiled container cache
cache/
tmp/
.phpunit.result.cache

# TanStack Router dev artefacts
.tanstack/

# Packaged plugin zips
*.zip

# Logs
*.log
npm-debug.log*

# Claude Code developer-local settings (never commit)
.claude/settings.local.json

# Playwright e2e output (see tests/e2e/)
/test-results/
/playwright-report/
/blob-report/
/.playwright/

# QA raw docs cache — 2 MB of re-fetchable scraped HTML. The digested
# .themegrill-qa/docs/*.md and docs-index.json ARE tracked; this is not.
.themegrill-qa/.docs-cache/
